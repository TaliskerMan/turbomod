# shellcheck shell=bash
# bash completion for turbomod
# Author: Chuck Talk, <chuck@nordheim.online>
# Install to /usr/share/bash-completion/completions/turbomod
_turbomod() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "${prev}" in
        enable|disable)
            mapfile -t COMPREPLY < <(compgen -W "--persist" -- "${cur}")
            return 0
            ;;
        *) ;;
    esac

    if [[ "${COMP_CWORD}" -eq 1 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "status enable disable restore --help --version" -- "${cur}")
    fi
    return 0
}
complete -F _turbomod turbomod
